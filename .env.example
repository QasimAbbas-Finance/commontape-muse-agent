# Copy to .env.local for local runs. Never commit a real key; on Vercel these live in the project's settings.

# Meta Model API (https://dev.meta.ai), OpenAI-compatible.
MODEL_API_KEY=
MODEL_BASE_URL=https://api.meta.ai/v1
MODEL_ID=muse-spark-1.3
ASR_MODEL=muse-voice-transcribe-1.0

# Or Meta's open-weights Muse Spark on Baseten (https://baseten.co), also OpenAI-compatible. It hears voice notes itself.
BASETEN_API_KEY=
OPEN_BASE_URL=https://inference.baseten.co/v1
OPEN_MODEL_ID=meta-models/muse-spark-open

# stub = no Meta model yet: a rule-based stand-in that names itself stub-no-key in the trace.
# muse = the Meta Model API. open = Muse Spark Open on Baseten.
# Left empty: muse when MODEL_API_KEY is set, else open when BASETEN_API_KEY is set, else stub.
MODEL_MODE=
